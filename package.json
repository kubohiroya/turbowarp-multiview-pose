{
  "name": "@kubohiroya/turbowarp-multiview-pose",
  "version": "0.2.0",
  "description": "A TurboWarp camera and fusion pipeline for WebGPU multi-person pose estimation over WebRTC.",
  "author": "Hiroya Kubo <hiroya@cuc.ac.jp>",
  "license": "MPL-2.0",
  "homepage": "https://kubohiroya.github.io/turbowarp-multiview-pose/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubohiroya/turbowarp-multiview-pose.git"
  },
  "bugs": {
    "url": "https://github.com/kubohiroya/turbowarp-multiview-pose/issues"
  },
  "keywords": [
    "turbowarp",
    "scratch",
    "extension",
    "movenet",
    "webgpu",
    "webrtc",
    "pose-estimation"
  ],
  "type": "module",
  "files": [
    "dist/",
    "config/",
    "docs/",
    "schemas/",
    "src/",
    "README.md",
    "README.ja.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "lint": "eslint config src tests scripts vite.config.ts",
    "format": "prettier --write config src tests scripts vite.config.ts",
    "format:check": "prettier --check config src tests scripts vite.config.ts",
    "test": "vitest run",
    "docs": "node scripts/generate-readme.ts",
    "docs:check": "pnpm run docs && git diff --exit-code -- README.md docs/turbowarp-extension-api.md",
    "schemas": "node scripts/generate-schemas.ts",
    "schemas:check": "pnpm run schemas && node scripts/check-schemas.ts",
    "repo:check": "node scripts/check-repo.ts",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run test && pnpm run docs:check && pnpm run schemas:check && pnpm run check:dist && pnpm run repo:check && pnpm run pack:check",
    "check:dist": "pnpm run build && node scripts/check-dist.ts"
  },
  "dependencies": {
    "@sinclair/typebox": "0.34.52",
    "@techstark/opencv-js": "4.12.0-release.1",
    "@tensorflow-models/pose-detection": "2.1.3",
    "@tensorflow/tfjs-backend-webgpu": "4.22.0",
    "@tensorflow/tfjs-converter": "4.22.0",
    "@tensorflow/tfjs-core": "4.22.0",
    "kalidokit": "1.1.5",
    "qrcode": "1.5.4"
  },
  "peerDependencies": {
    "@kubohiroya/turbowarp-aframe": "0.3.0",
    "@kubohiroya/turbowarp-camera-source": "0.5.0",
    "@kubohiroya/turbowarp-jsqr": "0.3.0",
    "@kubohiroya/turbowarp-webrtc": "0.3.0"
  },
  "peerDependenciesMeta": {
    "@kubohiroya/turbowarp-aframe": {
      "optional": true
    },
    "@kubohiroya/turbowarp-camera-source": {
      "optional": true
    },
    "@kubohiroya/turbowarp-jsqr": {
      "optional": true
    },
    "@kubohiroya/turbowarp-webrtc": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@kubohiroya/turbowarp-extension-template": "0.4.0",
    "@kubohiroya/vite-plugin-turbowarp-extension": "0.4.0",
    "@types/node": "^24.13.3",
    "@types/qrcode": "1.5.6",
    "eslint": "^9.39.5",
    "jsqr": "^1.4.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.10"
  }
}
